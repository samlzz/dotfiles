#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

# === GLOBALS ===

SCRIPT_NAME="$(basename "$0")"
DEPENDENCIES=(git fzf)

LOG_OPTS=()
SHOW_OPTS=()
REFS=()
PATHS=()
SHOW_STR=""
GRAPH=0
ALL=0

# Single source of truth for fzf keybinds: key:type:requires_all:description
# type is "action" (dispatched in run_fzf's case statement, goes in --expect)
# or "toggle" (bound separately via --bind, listed in help only).
# requires_all=1 means the action only makes sense when -a/--all is active
# (i.e. the log includes commits not already on the current branch).
KEYBINDS=(
	"enter:action:0:Open in pager"
	"ctrl-y:action:0:Copy hash to clipboard + notify"
	"ctrl-r:action:0:Interactive rebase from this commit (full todo)"
	"ctrl-e:action:0:Edit commit content  (amend, then git rebase --continue)"
	"ctrl-w:action:0:Reword commit message only"
	"ctrl-o:action:0:Checkout this commit"
	"ctrl-b:action:0:Create new branch from this commit"
	"ctrl-x:action:1:Cherry-pick onto current branch"
	"ctrl-u:action:0:Reset --soft to this commit"
	"ctrl-d:action:0:Multi-branch rebase (git-mrebase)"
	"ctrl-p:toggle:0:Toggle preview window"
	"?:toggle:0:Show this help"
)

# === FUNCTIONS ===

# fzf_keybinds [all_flag]
#   no arg    -> static help: show every keybind, annotate gated ones
#   "0" / "1" -> interactive help: hide keybinds gated on -a/--all accordingly
fzf_keybinds() {
	local all_flag="${1:-}"

	local bold='\033[1m'
	local cyan='\033[0;36m'
	local dim='\033[2m'
	local reset='\033[0m'

	local key="${cyan}${bold}"
	local sep="${dim}"

	printf "${bold}fzf keybinds${reset}\n\n"

	local entry k type requires_all desc label show_note
	for entry in "${KEYBINDS[@]}"; do
		IFS=':' read -r k type requires_all desc <<< "$entry"
		show_note=0
		if [[ "$requires_all" == "1" ]]; then
			if [[ -z "$all_flag" ]]; then
				show_note=1
			elif [[ "$all_flag" == "0" ]]; then
				continue
			fi
		fi
		label="$k"
		[[ "$k" == "enter" ]] && label="Enter"
		if [[ "$show_note" == "1" ]]; then
			printf "  ${key}%-8s${reset}  ${sep}|${reset}  %s  ${dim}(requires -a/--all)${reset}\n" "$label" "$desc"
		else
			printf "  ${key}%-8s${reset}  ${sep}|${reset}  %s\n" "$label" "$desc"
		fi
	done
}

usage() {
	cat >&2 <<EOF
Usage: ${SCRIPT_NAME} [LOG_OPTS] [SHOW_OPTS] [REF[..REF]] [-- <path>...]

Arguments:
  REF              Branch, tag, or commit range (e.g. main, v1.0, HEAD~5..HEAD)
  -- <path>...     Restrict history to these paths

Log filtering options (-> git log):
  -a, --all               Include all branches/tags/remotes
  -g, --graph             Show commit graph (like ggraph)
      --no-merges         Exclude merge commits
      --author=<pattern>  Filter by author name/email
      --grep=<pattern>    Filter by commit message content
      --since=<date>      Show commits newer than date
      --until=<date>      Show commits older than date

Preview options (-> git show in fzf):
  -s, --stat              Show file change statistics
  -q, --no-patch          Show commit message only, no diff
  -w, --word-diff         Word-level diff
  -n, --name-only         Show only names of changed files
      --name-status       Show names and status (A/M/D)

General:
  -h, --help              Show this help and exit

Note: keybinds marked "(requires -a/--all)" only appear in fzf when -a is
active, since they only make sense for commits not already on the current
branch.

fzf keybinds:
$(fzf_keybinds)
EOF
}

check_dependencies() {
	local cmd
	for cmd in "${DEPENDENCIES[@]}"; do
		if ! command -v "$cmd" &>/dev/null; then
			printf "Error: required tool '%s' is not installed or not in PATH\n" "$cmd" >&2
			exit 1
		fi
	done
}

detect_clipboard_cmd() {
	if command -v wl-copy &>/dev/null; then
		printf "wl-copy"
	elif command -v xclip &>/dev/null; then
		printf "xclip -selection clipboard"
	elif command -v xsel &>/dev/null; then
		printf "xsel --clipboard --input"
	else
		printf ""
	fi
}

check_dirty_and_stash() {
	[[ -z "$(git status --porcelain)" ]] && return 0

	printf "Uncommitted changes detected:\n"
	printf "  [s] Auto stash\n"
	printf "  [m] Stash with custom message\n"
	printf "  [n] Cancel\n"
	local choice
	read -r -n 1 -p "Choice [s/m/n]: " choice
	printf "\n"

	case "$choice" in
		s | S) git stash push -m "ghist: auto-stash" ;;
		m | M)
			local msg
			read -r -p "Stash message: " msg
			git stash push -m "$msg"
			;;
		*)
			printf "Operation cancelled.\n"
			return 1
			;;
	esac
}

action_pager() {
	local hash="$1"
	# shellcheck disable=SC2086
	git show --color=always "$hash" | ${PAGER:-less} ${LESS:-}
}

action_copy() {
	local hash="$1"
	local clipboard_cmd
	clipboard_cmd="$(detect_clipboard_cmd)"
	if [[ -n "$clipboard_cmd" ]]; then
		# shellcheck disable=SC2086
		printf '%s' "$hash" | $clipboard_cmd
		notify-send "ghist" "Hash $hash copied to clipboard" 2>/dev/null || true
	else
		printf "No clipboard tool available (install wl-copy or xclip)\n" >&2
	fi
}

action_rebase() {
	local hash="$1"
	check_dirty_and_stash || return
	git rebase -i "${hash}^"
}

action_edit() {
	local hash="$1"
	check_dirty_and_stash || return
	GIT_SEQUENCE_EDITOR="sed -i '0,/^pick/s/^pick/edit/'" git rebase -i "${hash}^"

	local choice
	printf "Rebase stopped at %s for editing.\n" "$hash"
	printf "Make your changes, then press Enter to amend + continue (or 'a' to abort): "
	read -r -n 1 choice
	printf "\n"
	if [[ "$choice" =~ ^[Aa]$ ]]; then
		git rebase --abort
		printf "Rebase aborted.\n"
		return
	fi
	git commit --amend
	git rebase --continue
}

action_reword() {
	local hash="$1"
	check_dirty_and_stash || return
	GIT_SEQUENCE_EDITOR="sed -i '0,/^pick/s/^pick/reword/'" git rebase -i "${hash}^"
}

action_checkout() {
	local hash="$1"
	check_dirty_and_stash || return
	git checkout "$hash"
}

action_branch() {
	local hash="$1"
	local name
	check_dirty_and_stash || return
	read -r -p "Branch name: " name
	[[ -z "$name" ]] && { printf "Cancelled.\n"; return; }
	git checkout -b "$name" "$hash"
}

action_cherry_pick() {
	local hash="$1"
	if [[ "$ALL" != "1" ]]; then
		printf "Error: cherry-pick requires -a/--all (commit must be outside the current branch)\n" >&2
		return
	fi
	check_dirty_and_stash || return
	git cherry-pick "$hash"
}

action_reset_soft() {
	local hash="$1"
	local choice
	printf "Reset --soft to %s? All commits after this will be unstaged. [y/N] " "$hash"
	read -r -n 1 choice
	printf "\n"
	[[ "$choice" =~ ^[Yy]$ ]] || { printf "Cancelled.\n"; return; }
	git reset --soft "$hash"
}

action_mrebase() {
	check_dirty_and_stash || return

	if ! command -v git-mrebase &>/dev/null; then
		printf "Error: git-mrebase not found in PATH\n" >&2
		return
	fi

	local -a branches
	mapfile -t branches < <(git branch --format='%(refname:short)')
	if [[ ${#branches[@]} -lt 2 ]]; then
		printf "Error: need at least 2 local branches for a multi-branch rebase\n" >&2
		return
	fi

	local base
	base=$(printf '%s\n' "${branches[@]}" \
		| fzf --prompt="mrebase base branch> " --height=~40% --layout=reverse) || {
		printf "Cancelled.\n"
		return
	}
	[[ -z "$base" ]] && { printf "Cancelled.\n"; return; }

	local targets_str
	targets_str=$(printf '%s\n' "${branches[@]}" | grep -Fxv "$base" \
		| fzf --multi --prompt="mrebase target branches (tab to select)> " --height=~40% --layout=reverse) || {
		printf "Cancelled.\n"
		return
	}
	[[ -z "$targets_str" ]] && { printf "No target branches selected. Cancelled.\n"; return; }

	local -a targets
	mapfile -t targets <<< "$targets_str"

	local -a mrebase_args=()
	local choice remote
	printf "Prompt to push all target branches after rebase? [y/N] "
	read -r -n 1 choice
	printf "\n"
	if [[ "$choice" =~ ^[Yy]$ ]]; then
		mrebase_args+=("--prompt")
		read -r -p "Remote [origin]: " remote
		[[ -n "$remote" ]] && mrebase_args+=("--remote" "$remote")
	fi

	printf "Running: git-mrebase %s %s %s\n" "${mrebase_args[*]-}" "$base" "${targets[*]}"
	# Run in the foreground (no command substitution) so git-mrebase's own
	# prompts/conflict handling get a real TTY, same as the other rebase
	# actions above — this is the fix for the ctrl-e "flash and nothing
	# happens" bug: never capture the output of an interactive git command.
	if ! git-mrebase "${mrebase_args[@]}" "$base" "${targets[@]}"; then
		printf "mrebase stopped (likely a conflict). Resolve it, then run:\n"
		printf "  git-mrebase --continue   (or --abort to cancel)\n"
	fi
}

run_fzf() {
	if [[ ${#SHOW_OPTS[@]} -gt 0 ]]; then
		SHOW_STR="${SHOW_OPTS[*]}"
	fi

	local git_args=()
	if [[ ${#LOG_OPTS[@]} -gt 0 ]]; then git_args+=("${LOG_OPTS[@]}"); fi
	if [[ ${#REFS[@]} -gt 0 ]]; then git_args+=("${REFS[@]}"); fi
	if [[ ${#PATHS[@]} -gt 0 ]]; then git_args+=("--" "${PATHS[@]}"); fi

	local script_path
	script_path="$(realpath "${BASH_SOURCE[0]}")"

	local help_state preview_visible preview_was_hidden
	help_state=$(mktemp)
	preview_visible=$(mktemp)
	preview_was_hidden=$(mktemp)
	printf '0' > "$help_state"
	printf '1' > "$preview_visible"
	printf '0' > "$preview_was_hidden"
	trap "rm -f '$help_state' '$preview_visible' '$preview_was_hidden'" EXIT

	# ctrl-p: toggle preview and sync the visible state file
	local ctrl_p_bind
	ctrl_p_bind="toggle-preview+execute-silent(
		if [[ \$(cat '$preview_visible') == '1' ]]; then
			printf '0' > '$preview_visible'
		else
			printf '1' > '$preview_visible'
		fi
	)"

	# ?: show help (auto-showing preview if hidden), or hide help (restoring hidden state)
	local toggle_help
	toggle_help="transform:
		if [[ \$(cat '$help_state') == '1' ]]; then
			printf '0' > '$help_state'
			if [[ \$(cat '$preview_was_hidden') == '1' ]]; then
				printf '0' > '$preview_was_hidden'
				printf '0' > '$preview_visible'
				printf 'hide-preview+refresh-preview'
			else
				printf 'refresh-preview'
			fi
		else
			printf '1' > '$help_state'
			if [[ \$(cat '$preview_visible') == '0' ]]; then
				printf '1' > '$preview_was_hidden'
				printf '1' > '$preview_visible'
				printf 'show-preview+refresh-preview'
			else
				printf '0' > '$preview_was_hidden'
				printf 'refresh-preview'
			fi
		fi"

	local expect_keys=()
	local entry k type requires_all desc
	for entry in "${KEYBINDS[@]}"; do
		IFS=':' read -r k type requires_all desc <<< "$entry"
		[[ "$type" != "action" ]] && continue
		[[ "$requires_all" == "1" && "$ALL" != "1" ]] && continue
		expect_keys+=("$k")
	done
	local expect_str
	expect_str=$(IFS=,; printf '%s' "${expect_keys[*]}")

	local result key hash query="" fzf_status

	while true; do
		fzf_status=0

		if [[ "$GRAPH" == "1" ]]; then
			# Prepend hash as a hidden tab-separated field 1 so {1} is always the hash,
			# regardless of how many graph characters precede it on the line.
			local preview_cmd="if [[ \$(cat '$help_state') == '1' ]]; then
				$script_path --fzf-help $ALL
			else
				[[ -n '{1}' ]] && git show --color=always $SHOW_STR '{1}'
			fi"
			result=$(git log --color=always \
				--pretty="tformat:%C(auto)%h%d %C(blue)%an %C(green)%ad%Creset %s" \
				--topo-order --date=human \
				--graph --decorate "--exclude=refs/stash" \
				"${git_args[@]}" \
				| awk '{
					match($0, /[0-9a-f]{7,40}/)
					print (RSTART ? substr($0, RSTART, RLENGTH) : "") "\t" $0
				}' \
				| fzf --ansi --no-sort \
					--delimiter=$'\t' --with-nth=2.. \
					--preview "$preview_cmd" \
					--preview-window='right:70%' \
					--print-query --query "$query" \
					--expect="$expect_str" \
					--bind "ctrl-p:$ctrl_p_bind" \
					--bind "?:$toggle_help"
			) || fzf_status=$?
		else
			local preview_cmd="if [[ \$(cat '$help_state') == '1' ]]; then
				$script_path --fzf-help $ALL
			else
				git show --color=always $SHOW_STR {1}
			fi"
			result=$(git log --color=always \
				--pretty="tformat:%C(auto)%h%d %C(blue)%an %C(green)%ad%Creset %s" \
				--date-order --date=human \
				--decorate "--exclude=refs/stash" \
				"${git_args[@]}" \
				| fzf --ansi --no-sort \
					--preview "$preview_cmd" \
					--preview-window='right:70%' \
					--print-query --query "$query" \
					--expect="$expect_str" \
					--bind "ctrl-p:$ctrl_p_bind" \
					--bind "?:$toggle_help"
			) || fzf_status=$?
		fi

		# Any non-zero exit (esc, ctrl-c, no match) quits the loop.
		[[ "$fzf_status" -ne 0 ]] && return

		query=$(sed -n '1p' <<< "$result")
		key=$(sed -n '2p' <<< "$result")

		local raw_line
		raw_line=$(sed -n '3p' <<< "$result")
		if [[ "$GRAPH" == "1" ]]; then
			# Field 1 is the hash prepended by awk (tab-separated, hidden from display)
			hash=$(printf '%s' "$raw_line" | cut -f1)
		else
			hash=$(printf '%s' "$raw_line" | awk '{print $1}')
		fi
		[[ -z "$hash" ]] && continue

		case "$key" in
			enter | "") action_pager       "$hash" ;;
			ctrl-y)     action_copy        "$hash" ;;
			ctrl-r)     action_rebase      "$hash" ;;
			ctrl-e)     action_edit        "$hash" ;;
			ctrl-w)     action_reword      "$hash" ;;
			ctrl-o)     action_checkout    "$hash" ;;
			ctrl-b)     action_branch      "$hash" ;;
			ctrl-x)     action_cherry_pick "$hash" ;;
			ctrl-u)     action_reset_soft  "$hash" ;;
			ctrl-d)     action_mrebase     "$hash" ;;
		esac
	done
}

expand_combined_flags() {
	local arg i
	for arg in "$@"; do
		if [[ "$arg" =~ ^-[[:alpha:]]{2,}$ ]]; then
			for (( i=1; i<${#arg}; i++ )); do
				printf -- '-%s\n' "${arg:$i:1}"
			done
		else
			printf '%s\n' "$arg"
		fi
	done
}

main() {
	local -a args
	mapfile -t args < <(expand_combined_flags "$@")
	set -- "${args[@]+"${args[@]}"}"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--)
			shift
			PATHS=("$@")
			break
			;;
		-h | --help)
			usage
			exit 0
			;;
		--fzf-help)
			fzf_keybinds "${2:-}"
			exit 0
			;;
		-a | --all)
			LOG_OPTS+=("--all")
			ALL=1
			;;
		-g | --graph)
			GRAPH=1
			;;
		--no-merges)
			LOG_OPTS+=("--no-merges")
			;;
		--author=* | --grep=* | --since=* | --until=*)
			LOG_OPTS+=("$1")
			;;
		--author | --grep | --since | --until)
			if [[ $# -lt 2 ]]; then
				printf "Error: '%s' requires an argument\n" "$1" >&2
				usage
				exit 1
			fi
			LOG_OPTS+=("$1" "$2")
			shift
			;;
		-s | --stat)
			SHOW_OPTS+=("--stat")
			;;
		-q | --no-patch)
			SHOW_OPTS+=("--no-patch")
			;;
		-w | --word-diff)
			SHOW_OPTS+=("--word-diff")
			;;
		-n | --name-only)
			SHOW_OPTS+=("--name-only")
			;;
		--name-status)
			SHOW_OPTS+=("--name-status")
			;;
		-*)
			printf "Error: unknown option '%s'\n" "$1" >&2
			usage
			exit 1
			;;
		*)
			REFS+=("$1")
			;;
		esac
		shift
	done

	check_dependencies

	if ! git rev-parse --git-dir &>/dev/null; then
		printf "Error: not a git repository\n" >&2
		exit 1
	fi

	run_fzf
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
	exit 0
fi
